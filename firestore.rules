rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المسؤول: مستخدم له مستند باسم معرّفه (UID) داخل مجموعة admins
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // المستعرض (مثل حساب العمداء): مستخدم له مستند باسم معرّفه داخل مجموعة viewers
    function isViewer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/viewers/$(request.auth.uid));
    }

    // بيانات المرشحين: القراءة للمسؤولين والمستعرضين فقط، والكتابة للمسؤولين فقط
    match /shards/{shardId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    // كل مستخدم يقرأ مستنده فقط للتحقق من صلاحيته، ولا أحد يكتب من الموقع
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /viewers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
